# ---------------------------------------------------------------------------
# Interlock voice interface — ElevenLabs configuration
#
# Copy this file to `voice/.env` (or add these keys to the repo-root `.env`)
# and fill in ELEVENLABS_API_KEY. Both files are ignored by Git (`*.env`).
# Never commit a real key, and never expose it to the browser: the Three.js
# frontend talks to THIS service, and only this service talks to ElevenLabs.
# ---------------------------------------------------------------------------

# Required. Create at https://elevenlabs.io/app/settings/api-keys
# Format: a long opaque token, usually prefixed with `sk_`.
ELEVENLABS_API_KEY=sk_replace_me

# Voice used for spoken replies. Find real IDs for your account with:
#   curl -s -H "xi-api-key: $ELEVENLABS_API_KEY" \
#     https://api.elevenlabs.io/v1/voices | python3 -m json.tool
# or GET http://127.0.0.1:8090/voice/voices once this service is running.
# Default below is the stock "Rachel" voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Text-to-speech model.
#   eleven_flash_v2_5  - lowest latency, best for live map narration (default)
#   eleven_turbo_v2_5  - slightly better quality, still fast
#   eleven_multilingual_v2 - highest quality, slowest
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Speech-to-text model for microphone questions.
ELEVENLABS_STT_MODEL=scribe_v1

# Audio container returned to the browser.
# mp3_44100_128 is widely supported; mp3_22050_32 is smaller and faster.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Voice delivery tuning, 0.0-1.0. Higher stability = flatter, more consistent
# reads, which suits street names and safety warnings.
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_SPEED=1.0

# --- Service settings (not ElevenLabs) ------------------------------------

# Where this voice service listens.
VOICE_HOST=127.0.0.1
VOICE_PORT=8090

# Browser origins allowed to call it. Comma-separated. The Vite dev server
# for the Three.js frontend runs on 127.0.0.1:5173.
VOICE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Set to 1 to run without an API key: /voice/ask still returns grounded answer
# text, but no audio is synthesized. Useful for offline demos and CI.
VOICE_TEXT_ONLY=0
