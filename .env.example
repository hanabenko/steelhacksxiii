# Local TimescaleDB development service
DATABASE_URL=postgresql://interlock:interlock_dev@localhost:5433/interlock


# Tiger Cloud uses the same variable. Its URL should normally include sslmode=require:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require


# ---------------------------------------------------------------------------
# ElevenLabs voice interface (see voice/.env.example for the full reference)
# ---------------------------------------------------------------------------


# PASTE YOUR KEY HERE
ELEVENLABS_API_KEY=


ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128


VOICE_HOST=127.0.0.1
VOICE_PORT=8090
VOICE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VOICE_TEXT_ONLY=0


# ---------------------------------------------------------------------------
# Google Gemini generative layer (see gemini/.env.example for the reference)
# ---------------------------------------------------------------------------


# PASTE YOUR KEY HERE
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.35
GEMINI_MAX_OUTPUT_TOKENS=1024


GEMINI_HOST=127.0.0.1
GEMINI_PORT=8091
GEMINI_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GEMINI_OFFLINE=0
