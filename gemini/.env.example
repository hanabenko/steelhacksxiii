# ---------------------------------------------------------------------------
# Interlock generative layer — Google Gemini configuration
#
# Copy this file to `gemini/.env` (or add these keys to the repo-root `.env`)
# and fill in GEMINI_API_KEY. Both files are ignored by Git (`*.env`).
# Never commit a real key, and never expose it to the browser: the Three.js
# frontend talks to THIS service, and only this service talks to Google.
# ---------------------------------------------------------------------------

# Required. Create at https://aistudio.google.com/app/apikey
# Format: a long opaque token, usually prefixed with `AIza`.
GEMINI_API_KEY=replace_me

# Model used for every generation task unless the task overrides it.
#   gemini-2.5-flash - fast and cheap, the right default for a hackathon demo
#   gemini-2.5-pro   - stronger reasoning, noticeably slower
#   gemini-2.0-flash - older, cheapest
GEMINI_MODEL=gemini-2.5-flash

# Low temperature keeps briefings and coaching consistent between runs.
# Scenario generation overrides this upward in the task catalog.
GEMINI_TEMPERATURE=0.35

# Ceiling on generated tokens per request. Interlock's outputs are all short.
GEMINI_MAX_OUTPUT_TOKENS=1024

# Seconds to wait for a response before failing over to the deterministic
# fallback text defined alongside each task.
GEMINI_TIMEOUT_SECONDS=30

# --- Service settings (not Gemini) ----------------------------------------

# Where this service listens. 8090 is the voice service, 8000 is reserved for
# the simulation API, so this defaults to 8091.
GEMINI_HOST=127.0.0.1
GEMINI_PORT=8091

# Browser origins allowed to call it. Comma-separated.
GEMINI_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Set to 1 to run with no API key at all: every task returns its deterministic
# fallback instead of calling Google. Useful for offline demos, CI, and for
# proving the app degrades cleanly when the quota runs out mid-presentation.
GEMINI_OFFLINE=0
